{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://site-manifest.dev/schema/site-manifest.schema.json",
  "type": "object",
  "required": ["id", "locales", "sections"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "localizedStringMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "imageValue": {
      "type": "object",
      "required": ["url"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "desktopPosition": {
          "type": "string"
        },
        "mobilePosition": {
          "type": "string"
        }
      }
    },
    "localizedImageMap": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/imageValue"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "groupChildField": {
      "type": "object",
      "required": ["key", "label"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "defaultValue": {
          "$ref": "#/$defs/localizedStringMap"
        }
      }
    },
    "repeaterItemField": {
      "oneOf": [
        {
          "type": "object",
          "required": ["key", "label", "kind"],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "const": "string"
            }
          }
        },
        {
          "type": "object",
          "required": ["key", "label", "kind"],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "minLength": 1
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "const": "image"
            },
            "withAlt": {
              "type": "boolean"
            },
            "withCaption": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "repeaterItemsByLocale": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/imageValue"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "stringField": {
      "type": "object",
      "required": ["key", "label", "kind"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "const": "string"
        },
        "hideable": {
          "type": "boolean"
        },
        "defaultValue": {
          "$ref": "#/$defs/localizedStringMap"
        }
      }
    },
    "imageField": {
      "type": "object",
      "required": ["key", "label", "kind"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "const": "image"
        },
        "hideable": {
          "type": "boolean"
        },
        "withAlt": {
          "type": "boolean"
        },
        "withCaption": {
          "type": "boolean"
        },
        "defaultValue": {
          "$ref": "#/$defs/localizedImageMap"
        }
      }
    },
    "groupField": {
      "type": "object",
      "required": ["key", "label", "kind", "fields"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "const": "group"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/groupChildField"
          }
        }
      }
    },
    "repeaterField": {
      "type": "object",
      "required": ["key", "label", "kind", "itemFields"],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "const": "repeater"
        },
        "hideable": {
          "type": "boolean"
        },
        "itemFields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/repeaterItemField"
          }
        },
        "defaultItems": {
          "$ref": "#/$defs/repeaterItemsByLocale"
        }
      }
    },
    "labelField": {
      "oneOf": [
        {
          "$ref": "#/$defs/stringField"
        },
        {
          "$ref": "#/$defs/imageField"
        },
        {
          "$ref": "#/$defs/groupField"
        },
        {
          "$ref": "#/$defs/repeaterField"
        }
      ]
    },
    "section": {
      "type": "object",
      "required": ["id", "title", "enabledByDefault", "labels"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "enabledByDefault": {
          "type": "boolean"
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/labelField"
          }
        }
      }
    }
  }
}
